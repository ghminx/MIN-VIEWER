<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MinViewerLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:colorAccent">@color/ui_navy</item>
        <item name="android:textColorPrimary">@color/ui_text_light</item>
        <item name="android:textColorSecondary">@color/ui_muted_light</item>
        <item name="android:textColorPrimaryInverse">@color/ui_surface_light</item>
        <item name="android:colorBackground">@color/ui_background_light</item>
        <item name="android:colorBackgroundFloating">@color/ui_surface_light</item>
        <item name="android:colorControlHighlight">@color/ui_selected_light</item>
        <item name="uiFieldColor">@color/ui_background_light</item>
        <item name="uiLineColor">@color/ui_line_light</item>
        <item name="uiSelectedColor">@color/ui_selected_light</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/ui_list_selector</item>
        <item name="android:alertDialogTheme">@style/MinViewerAlert</item>
        <item name="android:editTextStyle">@style/MinViewerInput</item>
        <item name="android:buttonStyle">@style/MinViewerButton</item>
        <item name="android:popupMenuStyle">@style/MinViewerPopup</item>
        <item name="android:listPopupWindowStyle">@style/MinViewerPopup</item>
        <item name="android:dropDownListViewStyle">@style/MinViewerDropDownList</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MinViewerMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MinViewerMenuText</item>
    </style>
    <style name="MinViewerDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:colorAccent">@color/ui_accent_dark</item>
        <item name="android:textColorPrimary">@color/ui_text_dark</item>
        <item name="android:textColorSecondary">@color/ui_muted_dark</item>
        <item name="android:textColorPrimaryInverse">@color/ui_navy</item>
        <item name="android:colorBackground">@color/ui_background_dark</item>
        <item name="android:colorBackgroundFloating">@color/ui_surface_dark</item>
        <item name="android:colorControlHighlight">@color/ui_selected_dark</item>
        <item name="uiFieldColor">@color/ui_background_dark</item>
        <item name="uiLineColor">@color/ui_line_dark</item>
        <item name="uiSelectedColor">@color/ui_selected_dark</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/ui_list_selector</item>
        <item name="android:alertDialogTheme">@style/MinViewerAlert</item>
        <item name="android:editTextStyle">@style/MinViewerInput</item>
        <item name="android:buttonStyle">@style/MinViewerButton</item>
        <item name="android:popupMenuStyle">@style/MinViewerPopup</item>
        <item name="android:listPopupWindowStyle">@style/MinViewerPopup</item>
        <item name="android:dropDownListViewStyle">@style/MinViewerDropDownList</item>
        <item name="android:textAppearanceLargePopupMenu">@style/MinViewerMenuText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/MinViewerMenuText</item>
    </style>
    <style name="MinViewerAlert" parent="android:style/ThemeOverlay.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:windowBackground">@drawable/ui_dialog_surface</item>
        <item name="android:editTextStyle">@style/MinViewerInput</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MinViewerPrimaryButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MinViewerButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MinViewerButton</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:textAppearanceLarge">@style/MinViewerDialogTitle</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/ui_list_selector</item>
    </style>
    <style name="MinViewerInput" parent="android:style/Widget.Material.EditText">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textColorHint">?android:attr/textColorSecondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/ui_input_background</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="MinViewerButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/ui_list_selector</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="MinViewerPrimaryButton" parent="MinViewerButton">
        <item name="android:textColor">?android:attr/textColorPrimaryInverse</item>
        <item name="android:background">@drawable/ui_primary_button</item>
    </style>
    <style name="MinViewerPopup" parent="android:style/Widget.Material.ListPopupWindow">
        <item name="android:popupBackground">@drawable/ui_popup_surface</item>
        <item name="android:popupElevation">10dp</item>
    </style>
    <style name="MinViewerDropDownList" parent="android:style/Widget.Material.ListView.DropDown">
        <item name="android:listSelector">@drawable/ui_list_selector</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>
    <style name="MinViewerMenuText" parent="android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="MinViewerDialogTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="MinViewerDocumentActions" parent="">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/ui_dialog_surface</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowElevation">12dp</item>
    </style>
</resources>
