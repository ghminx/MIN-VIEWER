<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="?attr/uiSelectedColor" /><corners android:radius="10dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="?attr/uiSelectedColor" /><corners android:radius="10dp" /><stroke android:width="2dp" android:color="?android:attr/colorAccent" /></shape></item>
    <item android:state_activated="true"><shape><solid android:color="?attr/uiSelectedColor" /><corners android:radius="10dp" /></shape></item>
    <item android:state_checked="true"><shape><solid android:color="?attr/uiSelectedColor" /><corners android:radius="10dp" /></shape></item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" /></shape></item>
</selector>
