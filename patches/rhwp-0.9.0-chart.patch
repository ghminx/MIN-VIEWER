+    #[test]
+    fn clustered_chart_displays_requested_series_values() {
+        let mut chart = bars_chart(BarGrouping::Clustered);
+        chart.series[0].values = vec![65.4];
+        chart.series[0].show_values = true;
+        chart.series[1].values = vec![60.0];
+        chart.series[1].show_values = true;
+        chart.series[2].values = vec![48.0];
+        chart.series[2].show_values = false;
+        chart.categories = vec!["".into()];
+        let svg = render_chart_svg(&chart, 0.0, 0.0, 400.0, 200.0);
+        let labels: Vec<_> = svg.lines().filter(|line| line.contains("hwp-chart-data-label")).collect();
+        assert_eq!(labels.len(), 2);
+        assert!(labels.iter().any(|line| line.contains(">65.4</text>")));
+        assert!(labels.iter().any(|line| line.contains(">60</text>")));
+    }
