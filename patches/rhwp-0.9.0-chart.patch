+fn format_clustered_data_label(v: f64, format_code: Option<&str>) -> Option<String> {
+    if !v.is_finite() || format_code.is_some_and(|code| !code.is_empty() && !code.eq_ignore_ascii_case("general")) {
+        return None;
+    }
+    format!("{:.14e}", v).parse::<f64>().ok().map(|value| value.to_string())
+}
